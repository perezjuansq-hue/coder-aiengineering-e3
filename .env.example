# OpenAI: obligatoria (se usa para los embeddings text-embedding-3-small, y para el chat si LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Anthropic: solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Proveedor del LLM que redacta las respuestas: openai o anthropic
LLM_PROVIDER=

# Modelos: Opcional. Si se deja vacío, se usa el modelo por defecto (anthropic:claude-haiku-4-5-20251001, openai:gpt-6-luna)
ANTHROPIC_MODEL=
OPENAI_MODEL=
